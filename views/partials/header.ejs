<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= siteName %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">
      <!-- Replace the placeholder with the final team-created logo. -->
      <img class="logo" src="/images/logo.png" alt="Team logo">
      <span class="brand-name"><%= siteName %></span>
    </a>
    <nav class="site-nav">
      <a href="/rooms">Book a room</a>
      <a href="/equipment">Book equipment</a>
      <a href="/bookings">All bookings</a>
      <a href="/rules">Rules</a>
    </nav>
  </header>
  <main>
    <% if (!databaseConnected) { %>
      <p class="warning">Preview mode: the database is offline. You can browse the website and schedules, but availability cannot be verified and bookings cannot be saved.</p>
    <% } %>
